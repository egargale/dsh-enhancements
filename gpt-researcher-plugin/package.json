{
  "name": "dsh-gpt-researcher-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: a faithful TypeScript port of assafelovic/gpt-researcher as native DeepSeek Harness tools (autonomous web research, deep research, multi-agent reports).",
  "type": "module",
  "license": "MIT AND Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "plugin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "link-dsh-deps": "bash scripts/link-dsh-deps.sh",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test 'test/**/*.test.ts'",
    "test:unit": "node --test 'test/unit/**/*.test.ts'",
    "test:integration": "node --test 'test/integration/**/*.test.ts'",
    "smoke": "bash scripts/smoke-headless.sh",
    "postinstall": "bash scripts/link-dsh-deps.sh || true"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
